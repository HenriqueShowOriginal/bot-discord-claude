# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ===== IA =====
# Ordem pela qual as IAs são tentadas. Se uma atingir o limite ou falhar, passa à seguinte.
# Opções: gemini, cerebras, groq, openrouter, ollama, claude
# Só são usadas as que tiverem chave preenchida em baixo.
AI_PROVIDERS=gemini,cerebras,groq

# Google Gemini — grátis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Cerebras — grátis: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Groq — grátis: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter — grátis com modelos ":free": https://openrouter.ai/keys
# (escolhe um modelo terminado em :free em https://openrouter.ai/models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama — IA local no teu PC (sem chave)
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:4b

# Claude (pago, mais fiável) — https://console.anthropic.com
# Adiciona "claude" ao AI_PROVIDERS para o usar, por ex. no fim como último recurso.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# (opcional) IDs de utilizadores extra que podem dar ordens, separados por vírgula
ALLOWED_USERS=
